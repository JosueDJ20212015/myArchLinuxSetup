# Notificaciones como islas, a juego con Waybar
# Estilo anterior: en git, commit 2bab881
anchor=bottom-right
font=JetBrains Mono 10
background-color=#1e1e1ecc
text-color=#e0e0e0
width=350
margin=0,10,10
padding=12
border-size=1
border-color=#ffffff1f
border-radius=10
progress-color=over #ffffff26
default-timeout=10000
group-by=summary
icons=1
max-icon-size=32

[grouped]
format=<b>%s</b>\n%b

[urgency=low]
text-color=#aaaaaa

# Unico acento de color: rojo suave, igual que el boton de apagado
[urgency=critical]
border-color=#e57373
default-timeout=0
